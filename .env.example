# 複製此檔為 .env，填入必要的 Discord ID 與 secret；絕不要提交 .env。
# 變更 provider 或模型參數後，請重新啟動 liuer-bot。

# Discord 設定
# Discord Bot Token；請只填入 .env，絕不要提交真正的 secret。
LIUER_DISCORD_TOKEN=replace-with-a-local-token

# 六耳唯一的一般聊天頻道；填入 Discord Channel ID。
LIUER_CHAT_CHANNEL_ID=123456789012345678

# Persona 公告，以及管理型 status/health 指令使用的頻道；填入 Discord Channel ID。
LIUER_PERSONA_STATUS_CHANNEL_ID=223456789012345678

# 對話上下文
# 記憶中保留的近期已完成對話回合數；預設 12，允許 1–50。
LIUER_CONTEXT_RECENT_TURNS=12

# 歷史已完成回合的 Unicode 字元預算（非輸出 token）；0 表示不帶入歷史。
# 不限制目前訊息、ReplyContext、Persona 或 system prompt。
# CHAT_SHORT / NORMAL / DEEP 預設分別為 1000 / 12000 / 24000 字元。
LIUER_CONTEXT_HISTORY_MAX_CHARS_CHAT_SHORT=1000
LIUER_CONTEXT_HISTORY_MAX_CHARS_NORMAL=12000
LIUER_CONTEXT_HISTORY_MAX_CHARS_DEEP=24000

# LLM Provider
# 可選：venice = Venice API；lm_studio = 本機 LM Studio。此範例選用 Venice。
LIUER_LLM_PROVIDER=venice

# Venice API
# Venice OpenAI-compatible API Base URL；只有選擇 Venice 時使用。
LIUER_VENICE_BASE_URL=https://api.venice.ai/api/v1

# Venice API key 是 secret；真正值只能填在 .env，絕對不要提交。
LIUER_VENICE_API_KEY=

# 沒有目前圖片的請求使用 TEXT；包含目前 prepared images 的請求使用 VISION。
# 以下是已驗證的公開模型 ID 範例，也可換成其他相容的 Venice 模型（須精確匹配 /models）。
# 更換模型 ID 後重新啟動 liuer-bot，並執行 /health。
LIUER_VENICE_TEXT_MODEL_ID=olafangensan-glm-4.7-flash-heretic

# VISION 模型須支援目前的圖片與多圖片能力。
LIUER_VENICE_VISION_MODEL_ID=qwen-3-6-plus

# LM Studio（本機 fallback）
# 以下 Base URL、模型 ID 與可選 API token 僅在 LIUER_LLM_PROVIDER=lm_studio 時使用。
# LM Studio OpenAI-compatible API 的 HTTP/HTTPS Base URL；預設為本機 1234 埠。
LIUER_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# 必須與 LM Studio /v1/models 回報的 model ID 完全相同，否則啟動/健康檢查失敗。
LIUER_LM_STUDIO_MODEL=replace-with-lm-studio-model-id

# 注意：下面三個鍵雖保留 LIUER_LM_STUDIO 前綴以相容既有設定，
# 但 LM Studio 和 Venice 都會使用！請求逾時預設 300 秒、取樣溫度預設 0.7。
# MAX_TOKENS=4096 是 DEEP／共用模型輸出 token 上限，不是歷史字元預算。
LIUER_LM_STUDIO_TIMEOUT_SECONDS=300
LIUER_LM_STUDIO_TEMPERATURE=0.7
LIUER_LM_STUDIO_MAX_TOKENS=4096

# CHAT_SHORT 輸出 token 上限 1024；NORMAL 輸出 token 上限 1536。
# 兩者與上方 DEEP／共用上限、歷史上下文字元預算是不同設定。
LIUER_RESPONSE_CHAT_SHORT_MAX_TOKENS=1024
LIUER_RESPONSE_NORMAL_MAX_TOKENS=1536

# 僅供 LM Studio 使用的可選 API secret；真正值只放在 .env。
LIUER_LM_STUDIO_API_TOKEN=

# 圖片取得與解碼安全限制（兩種 provider 共用）
# Discord 圖片下載逾時秒數，以及每則訊息最多選取的圖片數量。
LIUER_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
LIUER_MAX_IMAGES_PER_MESSAGE=4

# Discord 附件原始位元組上限：單張 10 MiB、單則訊息總計 20 MiB。
LIUER_MAX_IMAGE_BYTES=10485760
LIUER_MAX_TOTAL_IMAGE_BYTES=20971520

# 解碼安全上限：單張圖片最多 40,000,000 像素；不同於模型輸入限制。
LIUER_MAX_IMAGE_PIXELS=40000000

# 模型輸入正規化限制；與 Discord 位元組／解碼安全上限分開，不提高取得上限。
# 單張圖片最長邊上限（pixels）、單張像素上限，以及同一請求的總像素上限。
LIUER_MODEL_IMAGE_MAX_LONG_EDGE=2048
LIUER_MODEL_IMAGE_MAX_PIXELS=4000000
LIUER_MODEL_TOTAL_IMAGE_PIXELS=8000000

# 儲存與 Persona / 小名
# Production runtime 使用的本機 SQLite 路徑；啟動時會建立或執行必要的 schema migration。
LIUER_DATABASE_PATH=data/liuer.sqlite3

# Community Persona 最大長度（Unicode 字元）；Doctor 只驗證設定，不開啟 SQLite。
LIUER_PERSONA_MAX_CHARS=4000

# Persona 全域更新冷卻秒數，以及每位使用者每日成功更新次數上限。
LIUER_PERSONA_GLOBAL_COOLDOWN_SECONDS=1200
LIUER_PERSONA_DAILY_LIMIT=3

# 每日配額重置的 UTC 時區偏移小時；8 代表以 UTC+8 邊界計算。
LIUER_PERSONA_DAILY_RESET_UTC_OFFSET_HOURS=8

# Active Nickname 正規化後的最大長度（Unicode 字元）；目前上限 32。
# 小名沿用上方冷卻與配額設定，但冷卻和成功更新次數獨立計算。
LIUER_NICKNAME_MAX_CHARS=32

# 日誌或其他 runtime 設定
# 日誌等級；可用 DEBUG、INFO、WARNING、ERROR、CRITICAL，預設 INFO。
LIUER_LOG_LEVEL=INFO
